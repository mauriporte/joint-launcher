<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- the TV's own network address, for the phone sign-in page's QR code -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- tablet: "Uninstall" on an app opens Android's own confirm screen -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- only takes effect if granted over adb; used solely to switch our Home button service back on after updates -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android 11+ package visibility for the apps we launch -->
    <queries>
        <package android:name="com.live.geesports" />
        <package android:name="com.netflix.ninja" />
        <package android:name="org.smarttube.beta" />
        <package android:name="com.stremio.one" />
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.disney.disneyplus" />
        <package android:name="com.hulu.livingroomplus" />
        <package android:name="com.peacocktv.peacockandroid" />
        <package android:name="au.com.stan.and" />
        <package android:name="com.wbd.stream" />
        <package android:name="com.filmin.androidtv" />
        <package android:name="com.spotify.tv.android" />
        <package android:name="org.videolan.vlc" />
        <!-- phone/tablet versions (Links.MOBILE) -->
        <package android:name="com.netflix.mediaclient" />
        <package android:name="com.android.youtube.premium" />
        <package android:name="app.revanced.android.youtube" />
        <package android:name="com.google.android.youtube" />
        <package android:name="com.spotify.music" />
        <package android:name="org.jellyfin.mobile" />
        <package android:name="com.amazon.avod.thirdpartyclient" />
        <package android:name="com.hulu.plus" />
        <package android:name="es.filmin.app" />
        <!-- icon packs (ADW / Nova format), for app icons -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
        <!-- every app on a phone/tablet, for the "Your apps" row -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="stremio" />
        </intent>
        <!-- to list every TV app for the "Your apps" row -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
    </queries>

    <application
        android:label="Joint Launcher"
        android:icon="@drawable/icon"
        android:banner="@drawable/banner"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <!-- singleTask: pressing Home brings back this one home screen instead of stacking new copies -->
        <!-- configChanges: turning a tablet keeps the screen as it is instead of rebuilding it -->
        <!-- resizeableActivity false: the home screen is always full screen, so no split-screen / floating-window
             handle (Xiaomi's "•••" bar) on it -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:stateNotNeeded="true" android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- lets Joint Launcher be chosen as the TV's home screen -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Home button catcher (Google TV ignores the default-home setting); off until switched on in Accessibility -->
        <service
            android:name=".HomeButtonService"
            android:process=":home"
            android:exported="true"
            android:label="@string/home_button_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_button_service" />
        </service>

        <receiver android:name=".HomeButtonService$Restorer" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".NowPlayingListener"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />
    </application>
</manifest>
