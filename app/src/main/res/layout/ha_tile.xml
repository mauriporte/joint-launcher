<?xml version="1.0" encoding="utf-8"?>
<!-- one MauHome tile: icon in a tinted round badge, padlock for the server plugs, name and state at the bottom -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ha_tile" android:layout_width="match_parent" android:layout_height="100dp"
    android:background="@drawable/ha_tile_off" android:padding="10dp">
    <ImageView android:id="@+id/ha_badge" android:layout_width="34dp" android:layout_height="34dp"
        android:src="@drawable/ha_badge" android:alpha="0.18" />
    <ImageView android:id="@+id/ha_icon" android:layout_width="34dp" android:layout_height="34dp" android:padding="7dp" />
    <ImageView android:id="@+id/ha_lock" android:layout_width="14dp" android:layout_height="14dp"
        android:layout_gravity="top|end" android:src="@drawable/ic_lock" android:alpha="0.55" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical">
        <TextView android:id="@+id/ha_name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:singleLine="true" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/ha_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:singleLine="true" android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
